is_installed() { local fn=is_installed; # is_installed ENTRY -- exit 0 when the world-file entry is installed
    case "$1" in manual*) return 0 ;; esac   # installed by hand: nothing to ask, it counts as there
    # shellcheck disable=SC2086  # an entry may name several packages
    case $DISTRO in
        brew) _ii=${1#* \"}; _ii=${_ii%%\"*}
              case "$1" in
                  'brew "'*) "$c_brew" list --formula "$_ii" >/dev/null 2>&1 ;;
                  'cask "'*) "$c_brew" list --cask "$_ii" >/dev/null 2>&1 ;;
                  'tap "'*)  "$c_brew" tap | grep -qx "$_ii" ;;
                  *) return 1 ;;
              esac ;;
        fedora|opensuse) rpm -q $1 >/dev/null 2>&1 ;;
        arch)   $c_ARCH -Q $1 >/dev/null 2>&1 ;;
        debian) dpkg-query -W $1 >/dev/null 2>&1 ;;
        *) XXXX $DISTRO $fn; ;;
    esac
}

list_setups() { # this machine's set-ups: "ENTRY<tab>COMMAND", in world-file order, each command once
    [ -r "$WORLDFILE_SRC" ] || err 021 "cannot read the world file '$WORLDFILE_SRC'"
    world_select setups "$WORLDFILE_SRC"
}
run_setups() { # each set-up of this machine whose package is installed; 1 when one failed -- a set-up
               # runs on every -U, so it must change nothing when it is in place already
    _su=$(new_tempfile); TEMPFILES="$TEMPFILES $_su"
    list_setups > "$_su" || return 1
    _su_bad=0
    while IFS="$TAB" read -r _su_e _su_c <&3; do   # the list on fd 3: a set-up may read stdin
        if ! is_installed "$_su_e"; then
            echo " >>> skipped: $_su_c   ($_su_e is not installed: worldfile -M)"; continue
        fi
        echo " >>> $_su_c   (the set-up of $_su_e)"
        sh -c "$_su_c"; _su_rc=$?
        if [ "$_su_rc" = 0 ]; then echo "    > done [0]"
        else echo "    > FAILED [$_su_rc] $_su_c" 1>&2; _su_bad=$((_su_bad+1)); fi
    done 3< "$_su"
    [ "$_su_bad" = 0 ] || { echo "$_su_bad set-up(s) FAILED" 1>&2; return 1; }
}


rebuild_keepfile() { local fn=rebuild_keepfile;
    if [ -z "$DIRTY" -a "$DISTRO" = "fedora" ]; then

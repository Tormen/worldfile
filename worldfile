    _rt_check "WORLDFILE empty: ${_rt_c%%|*} ${_rt_r%|*} reads package-list.${_rt_c##*|}" \
      "$(WORLDFILE_CONFIG=$T/conf.noworld "$T/wf" -D -R 2>&1 | sed -n "s/^WORLDFILE='\(.*\)'$/\1/p")" "/etc/package-list.${_rt_c##*|}"
  done
  echo Darwin > "$T/uname"
}

_rt_check() {
  if [ "$2" = "$3" ]; then echo "  PASS  $1"; _rt_pass=$((_rt_pass+1))
  else printf '  FAIL  %s\n    got:  %s\n    want: %s\n' "$1" "$2" "$3"; _rt_fail=$((_rt_fail+1)); fi
}
_rt_copy() { # $T/wf: this file with its keep list in $T, brew = the stub, and uname / os-release / hostname read from $T
  sed -e "s|^OS_RELEASE=.*|OS_RELEASE=$T/os-release|" -e "s|\"\$(uname -s)\"|\"\$(cat $T/uname)\"|" \
      -e "s|\"\$(hostname -s)\"|\"\$(cat $T/hostname)\"|" "$B" > "$T/wf"
  chmod 700 "$T/wf"
  for _rt_d in brew fedora; do # $T/wf.DISTRO: $T/wf with a config setting DISTRO and reading $T/world
    printf 'DISTRO=%s\nWORLDFILE="%s/world"\nKEEPFILE="%s/keep"\nc_BREW="%s/bin/brew"\n' "$_rt_d" "$T" "$T" "$T" > "$T/conf.$_rt_d"
    printf '#!/bin/sh\nWORLDFILE_CONFIG=%s/conf.%s exec %s/wf "$@"\n' "$T" "$_rt_d" "$T" > "$T/wf.$_rt_d"
    chmod 700 "$T/wf.$_rt_d"

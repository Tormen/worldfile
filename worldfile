    "$(WORLDFILE_CONFIG=$T/conf.sel "$T/wf" -u)" "$(printf 'brew "box"\twfs box\nbrew "mine"\tcat >/dev/null; wfs mine\nbrew "plus"\twfs shared\ncask "absent"\twfs absent\nmanual "Tool"\twfs tool\nbrew "fails"\twfs fails; exit 3\n')"
}
rt_setup_run() {
  : > "$T/setup.log"

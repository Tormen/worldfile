# The settings: printed by --create-config, and in effect when no config file is found.
default_config_content() {
    cat <<'_EOF'
# worldfile config -- plain shell, sourced at startup (worldfile --help: where it is looked for)

# brew, fedora, arch, debian or opensuse; empty = detected: brew on macOS,
# else the ID (or ID_LIKE) in /etc/os-release
DISTRO=

# the world file: the packages this machine should have
WORLDFILE="/etc/package-list"

# the keep list: the world file stripped to package names, rebuilt by every command that needs it
# (brew keeps its Brewfile.lock.json beside it); empty = /var/cache/worldfile/<DISTRO>.keeplist,
# fedora: a temp file of the run
KEEPFILE=

# brew only: the brew to run; empty = /opt/homebrew/bin/brew, else /usr/local/bin/brew
c_BREW=

# width of the name column in the "nice" lists (-ll, -mm, ...)
MAX_PACKAGE_NAME_LENGTH=40

# arch only: the package manager command (yaourt, pacman, "sudo -u <user> pacaur", ...)
c_ARCH="yay"

# fedora only: dnf, and the transactions that built the image -- what they installed is
# the image's, not "on top" of the world file (dnf5 history list: the first, kiwi's)
c_DNF=dnf5
FEDORA_IMAGE_TRANSACTIONS="1 2"
_EOF
}


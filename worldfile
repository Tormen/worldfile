# uses flag_filterByLeadingSpaces
list_worldfile() { # == includes
    case $DISTRO in
        brew) APPENDIX="$(cat "$WORLDFILE"|sed -n 's/^[[:space:]]*##*[[:space:]]*\(manual[[:space:]][[:space:]]*[^[:space:]][^[:space:]]*\).*/\1/p'|sort)";;
        *) APPENDIX="";;
    esac

    # fedora: for a in $(rpmorphan -list-keep); do echo "$a"; done
    # GENERAL:
    if [ -z "$flag_filterByLeadingSpaces" ]; then 
      cat "$KEEPFILE"
      [ -n "$APPENDIX" ] && echo "$APPENDIX"
    else
      echo "cat \"$WORLDFILE\"|grep -v '^[[:space:]]*#'|sed -n \"s/^[[:space:]]\\{$flag_filterByLeadingSpaces\\}\\([^[:space:]]\\)/\\1/p\"|sed -e 's/[[:space:]]*#.*//' -e 's/[[:space:]][[:space:]]*/ /g'|grep -v '^[[:space:]]*$'"
      cat "$WORLDFILE"|grep -v '^[[:space:]]*#'|sed -n "s/^[[:space:]]\{$flag_filterByLeadingSpaces\}\([^[:space:]]\)/\1/p"|sed -e 's/[[:space:]]*#.*//' -e 's/[[:space:]][[:space:]]*/ /g'|grep -v '^[[:space:]]*$'
      [ -n "$APPENDIX" ] && echo "$APPENDIX"
    fi
}
list_worldfile_comments() { # == excludes
    case $DISTRO in

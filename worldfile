_rt_copy() { # $T/wf: this file with its keep list in $T, brew = the stub, and uname / os-release read from $T
  sed -e "s|^OS_RELEASE=.*|OS_RELEASE=$T/os-release|" -e "s|\"\$(uname -s)\"|\"\$(cat $T/uname)\"|" "$B" > "$T/wf"

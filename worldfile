list_dnf() { # list_dnf FILE ARGS... -- "$c_DNF" ARGS into FILE; its stderr is shown only when it fails
    _ld_f=$1; shift
    # shellcheck disable=SC2154  # c_DNF is set by the config
    "$c_DNF" "$@" > "$_ld_f" 2> "$_ld_f.err" && return 0
    _ld_rc=$?; cat "$_ld_f.err" 1>&2; err "FAILED [$_ld_rc] $c_DNF $*"
}

list_orphanedPackages() { local fn=list_orphanedPackages;
    case $DISTRO in
        fedora) # what dnf records as installed on purpose, minus what the image installed, minus the world
                # file (its '# manual' entries too); dependencies are out already: dnf records them as such
            _usr=$(new_tempfile); _img=$(new_tempfile); _keep=$(new_tempfile)
            TEMPFILES="$TEMPFILES $_usr $_usr.err $_img $_img.err $_keep"
            list_dnf "$_usr" repoquery --userinstalled --qf '%{name}\n'
            : > "$_img"   # no image transactions configured: 'history info' with none would list the LAST one
            # shellcheck disable=SC2086  # FEDORA_IMAGE_TRANSACTIONS is a list of ids
            [ -n "$FEDORA_IMAGE_TRANSACTIONS" ] && list_dnf "$_img" history info $FEDORA_IMAGE_TRANSACTIONS
            { cat "$KEEPFILE"
              sed -n 's/^[[:space:]]*##*[[:space:]]*manual[[:space:]][[:space:]]*\([^[:space:]]*\).*/\1/p' "$WORLDFILE" | tr -d '"'
            } | LC_ALL=C sort -u > "$_keep"
            # 'history info' rows: "  Install name-epoch:version-release.arch  Reason  Repository"
            awk '/^  / && $2 ~ /:/ { print $2 }' "$_img" | sed 's/-[^-]*-[^-]*$//' >> "$_keep"
            LC_ALL=C sort -u "$_keep" -o "$_keep"
            LC_ALL=C sort -u "$_usr" | LC_ALL=C comm -23 - "$_keep"
            ;;
        brew) [ $DBG ] && echo "   \"$c_brew\" bundle --file="$KEEPFILE" --verbose cleanup";
              "$c_brew" bundle --file="$KEEPFILE" --verbose cleanup ;;
        arch)  $c_ARCH -Qtdq ;; # pacaur -Qtdi; ;;
               # Either pacman -Qdtq | sudo pacman -Rns -   # <<< removes all unneeded packages, but leaves optional dependencies intact
               # Or     pacman -Qdttq | sudo pacman -Rns -  # <<< removes optional dependencies as well
        debian)
            #echo "deborphan -k '$KEEPFILE'" 1>&2 # DBG:
            deborphan -a -k "$KEEPFILE"|awk '{print $2}' 2>&1 #|sed -n 's/deborphan: package \(.*\) not found or not installed/\1/p'; ;;
            ;;
        *) XXXX $DISTRO $fn; ;;
    esac
}
remove_orphanedPackages() { local fn=remove_orphanedPackages;
    if [ "$DISTRO" != "brew" ]; then tmp="$( $0 -o )"; [ -z "$tmp" ] && return; fi # nothing to do
    case $DISTRO in
        fedora) yum remove $tmp; ;;
        brew) [ $DBG ] && echo "   \"$c_brew\" bundle --file="$KEEPFILE" --verbose --force cleanup";
              "$c_brew" bundle --file="$KEEPFILE" --verbose --force cleanup ;;
        arch) $c_ARCH -R --nosave --recursive --unneeded $tmp; ;;  # == $c_ARCH -Rcsu
            #tmp=$( $c_ARCH -Q --deps --unrequired| xargs echo );
            #[ -n "$tmp" ] && $c_ARCH -R --cascade --recursive --unneeded $tmp; ;;  # == $c_ARCH -Rcsu
        debian) [ $flag_PURGE ] && opt=--purge || opt=; apt-get remove -V $opt $tmp; ;;
        *) XXXX $DISTRO $fn; ;;
    esac
}



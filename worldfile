# returns 0 = yes(success)  AND  1 = no(failed)
getOK() { local _ASKSTRING=$1;
  local _a="";
  while [ 1 ]; do
    printf "$_ASKSTRING";
    read _a;
    [ $DBG ] && echo "DBG: getOK(): got '$_a'" 1>&2
    case "$_a" in
      [yY]|[yY][eE][sS]|[zZ]|[zZ][eE][sS]) [ $DBG ] && echo "DBG: getOK(): return 0 (yes)" 1>&2;
      return 0;;
      [nN]|[nN][oO]|[nN][oO][nN]) [ $DBG ] && echo "DBG: getOK(): return 1 (no)" 1>&2;
      return 1;;
    esac
  done;
}


run_tests() { # run_tests [SUBSTRING] -- exit 0 = all passed
  # the run list: each name NAME is the test function rt_NAME, run in this order
  _rt_all="brew_R brew_l brew_L brew_o fedora_o fedora_o_dnf_fails detect_macos detect_fedora detect_like detect_unknown config_wins create_config err_stderr debug_stdout world_per_os select select_tier_only_when_needed select_errors setup_list setup_run plain_sh guard"
  _rt_tot=0; _rt_n=0; _rt_sel=
  for _rt_a in $_rt_all; do
    _rt_tot=$((_rt_tot+1))
    case "$_rt_a" in *"$1"*) _rt_n=$((_rt_n+1)); _rt_sel="$_rt_sel $_rt_a" ;; esac
  done
  [ "$_rt_n" -gt 0 ] || err 022 "--run-tests: no test name contains '$1' (tests: $_rt_all)"

  B=$(_rt_self) || err 023 "--run-tests: cannot resolve the real path of '$0'"
  T=$(mktemp -d /tmp/worldfile-tests.XXXXXX) || err 024 "--run-tests: mktemp -d failed"
  trap 'rm -rf "$T"' 0
  mkdir "$T/bin"
  # shellcheck disable=SC2016  # the stub's $* must expand when IT runs
  printf '#!/bin/sh\ncase "$1" in list) grep -qx "$3" "%s/installed"; exit ;; tap) cat "%s/installed"; exit ;; esac\necho "$*" >> "%s/brew.log"\nfor a; do case "$a" in --file=*) cat "${a#--file=}" > "%s/keep.seen" ;; esac; done\nprintf "Would uninstall formulae:\\nstray\\n"\n' "$T" "$T" "$T" "$T" > "$T/bin/brew"
  chmod 700 "$T/bin/brew"
  printf '%s\n' '#### SECTION' 'brew "grep"   # why' 'tap "a/b"' '  brew "git"' '# brew "old"' 'cask "iterm2"' '' '# manual "Some App"' '#manual "Other Tool"   # by hand' > "$T/world"
  echo Darwin > "$T/uname"; echo my-box > "$T/hostname"; _rt_copy
  # the selector world: this machine is my-box, tier MINE (the stub logs each call)
  printf '#!/bin/sh\necho called >> "%s/tier.log"\necho MINE\n' "$T" > "$T/bin/tier"; chmod 700 "$T/bin/tier"
  printf '%s\n' 'brew "all"' 'brew "box"     # @my-box  setup: wfs box' 'brew "other"   # @my-boxer  setup: wfs other' \
    'brew "mine"    # why %MINE  setup: cat >/dev/null; wfs mine' 'brew "foreign" # %FOREIGN  setup: wfs foreign' \
    'brew "plus"    # %FOREIGN+@my-box  setup: wfs shared' 'brew "minus"   # %MINE-@my-box' 'brew "both"  # %MINE+@my-box  setup: wfs shared' \
    'brew "mail"    # ask me@home' '# brew "gone"  # %MINE  setup: wfs gone' 'cask "absent"  # setup: wfs absent' \
    '# manual "Tool"  # by hand  setup: wfs tool' 'brew "fails"  #setup: wfs fails; exit 3' > "$T/world.sel"
  printf '%s\n' all box mine plus both fails > "$T/installed"
  # shellcheck disable=SC2016  # expands when the stub, or the config, runs
  printf '#!/bin/sh\necho "$1" >> "%s/setup.log"\n' "$T" > "$T/bin/wfs"; chmod 700 "$T/bin/wfs"
  # shellcheck disable=SC2016  # expands when the stub, or the config, runs
  printf 'DISTRO=brew\nWORLDFILE="%s/world.sel"\nKEEPFILE="%s/keep.sel"\nc_BREW="%s/bin/brew"\nTIER_COMMAND="%s/bin/tier"\nTIERS="MINE MAINTAIN FOREIGN"\nPATH="%s/bin:$PATH"\n' "$T" "$T" "$T" "$T" "$T" > "$T/conf.sel"
  # dnf5 as Fedora's: --installed and --userinstalled refuse each other, a dependency is installed
  # but not user-installed, and 'history info' lists NEVRAs under a header
  cat > "$T/bin/dnf5" <<'_EOF'
#!/bin/sh
echo "Updating and loading repositories:" >&2
case "$*" in
  *--installed*--userinstalled*|*--userinstalled*--installed*) echo "Option --userinstalled conflicts with --installed" >&2; exit 2 ;;
  "repoquery --userinstalled --qf %{name}\n") [ -n "$DNF_STUB_FAIL" ] && exit 1; printf '%s\n' zsh mmv basesystem my-local-tool ;;
  "repoquery --installed --qf %{name}\n")     printf '%s\n' zsh mmv basesystem my-local-tool bash libfoo ;;
  "history info 1 2")
    printf '%s\n' 'Transaction ID : 1' 'Description    : dnf5 --config /kiwi_dnf5.conf install basesystem' 'Packages altered:' \
      '  Action  Package                            Reason      Repository' \
      '  Install basesystem-0:11-22.fc42.noarch     User        fbf5' \
      '  Install bash-0:5.2.37-1.fc42.x86_64        Dependency  fbf5' ;;
  *) echo "dnf5 stub: unexpected '$*'" >&2; exit 9 ;;
esac
_EOF
  chmod 700 "$T/bin/dnf5"
  printf 'DISTRO=fedora\nWORLDFILE="%s/world.fedora"\nc_DNF=%s/bin/dnf5\n' "$T" "$T" > "$T/conf.fedora.o"

  # TAP-style: "1..N" first, then "ok K - name" / "not ok K - name" as each test ends;
  # a test failed when the failure counter grew during it
  _rt_pass=0; _rt_fail=0; _rt_k=0
  echo "1..$_rt_n"
  for _rt_a in $_rt_sel; do
    _rt_k=$((_rt_k+1)); _rt_bad=$_rt_fail
    "rt_$_rt_a"
    if [ "$_rt_fail" = "$_rt_bad" ]; then echo "ok $_rt_k - $_rt_a"; else echo "not ok $_rt_k - $_rt_a"; fi
  done

  echo " >>> self-test: $_rt_pass passed, $_rt_fail failed"
  [ "$_rt_fail" -eq 0 ]
}


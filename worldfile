      cat "$WORLDFILE"|sed -e 's/[[:space:]]*#.*//' -e 's/[[:space:]][[:space:]]*/ /' -e 's/[[:space:]]*$//' -e 's/^[[:space:]]*//'|grep -v '^[[:space:]]*$'|sort|uniq >"$tmpFile"
      cat "$tmpFile"|grep "^tap"
      cat "$tmpFile"|grep "^brew"
      cat "$tmpFile"|grep "^cask"
      return 0
      ;;
    arch)
      cat "$WORLDFILE"|sed -e 's/[[:space:]]*#.*//' -e 's/[[:space:]]*//' -e's/[[:space:]]*$//' -e's|[^[:space:]]\+/\([^[:space:]]\+\)$|\1|' -e"s/ /\n/g"|grep -v '^[[:space:]]*$'|sort|uniq ;; # |while read a; do echo "$a"; done
    *)
      # strip out everything but the pure packagenames from the worldfile:
      cat "$WORLDFILE"|sed -e 's/[[:space:]]*#.*//' -e 's/[[:space:]]*//' -e's/[[:space:]]*$//' -e"s/ /\n/g"|grep -v '^[[:space:]]*$'|sort|uniq ;;
  esac
}



list_missingPackages() { local fn=list_missingPackages;
    case $DISTRO in
        brew)
            [ $DBG ] && echo "DBG: list_missingPackages(): \"$c_brew\" bundle --file=\"$KEEPFILE\" check --verbose -- its answer, unfiltered, on stderr" 1>&2
            "$c_brew" bundle --file="$KEEPFILE" check --verbose|{ if [ $DBG ]; then tee /dev/stderr; else cat; fi; }|grep -v "^The Brewfile's dependencies are satisfied.\|\"$c_brew\" bundle can't satisfy your .* dependencies.\|Satisfy missing dependencies with .*"|sed -e 's/→ Formula \(.*\) needs to be installed or updated./brew "\1"/'|sed -e 's/→ Cask \(.*\) needs to be installed or updated./cask "\1"/'|sed -e 's/→ Tap \(.*\) needs to be tapped./tap "\1"/'
            ;;
        fedora) $0 -l|xargs yum install|grep -v 'already installed and latest version'; ;;
        arch) 
            ### Filter all non-installed packages (including groups):
            # -Q only works on INSTALLED stuff !!
            # --> so we'll filter the errors as the missing packages!
            [ $DBG ] && echo "DBG: $c_ARCH -Q $(cat "$KEEPFILE"|xargs echo) 2>&1 >/dev/null" 1>&2
            tmp="$($c_ARCH -Q $(cat "$KEEPFILE"|xargs echo) 2>&1 >/dev/null)";
            [ $DBG ] && echo "DBG: --> tmp='$tmp' (output of $c_ARCH -Q <KEEPFILE>)" 1>&2
            [ -z "$tmp" ] && return;
            tmp2="$(echo "$tmp"|sed -n "s/^error: package '\([^']\+\)' was not found$/\1/p")"
            [ $DBG ] && echo "DBG: --> tmp2='$tmp2' (tmp stripped to package names)" 1>&2
            [ "$(echo "$tmp"|wc -l)" != "$(echo "$tmp2"|wc -l)" ] && err 016 "list_missingPackages: INTERNAL ERROR. There seems to be a format problem in the output of pacaur -Q. (See tmp='$tmp', tmp2='$tmp2'.)"

            ### Filter out groups:
            [ $DBG ] && echo "DBG: $c_ARCH -Q --groups $(echo "$tmp2"|xargs echo) 2>&1 >/dev/null" 1>&2
            tmp="$($c_ARCH -Q --groups $(echo "$tmp2"|xargs echo) 2>&1 >/dev/null)"
            [ $DBG ] && echo "DBG: --> tmp='$tmp' (output of $c_ARCH -Q --groups <KEEPFILE>)" 1>&2
            [ -z "$tmp" ] && return;
            tmp2="$(echo "$tmp"|sed -n "s/^error: group '\([^']\+\)' was not found$/\1/p")"
            [ $DBG ] && echo "DBG: --> tmp2='$tmp2' (tmp stripped to package names)" 1>&2
            [ "$(echo "$tmp"|wc -l)" != "$(echo "$tmp2"|wc -l)" ] && err 017 "list_missingPackages: INTERNAL ERROR. There seems to be a format problem in the output of pacaur -Q --groups. (See tmp='$tmp', tmp2='$tmp2'.)"

            echo "$tmp2"|sort
            ;; 
        debian) cat "$KEEPFILE"|deborphan -a - 2>&1|sed -n 's/deborphan: package \(.*\) not found or not installed/\1/p'; ;;
        #opensuse) $0 -l|xargs zypper --terse search --uninstalled --match-exact --type package|tail -n+6|cut -f 2 -d"|"; ;;
        opensuse) $0 -l|xargs rpm -q|sed -n 's/^package \(.*\) is not installed$/\1/p'; ;;
        *) XXXX $DISTRO $fn; ;;
    esac
}
install_missingPackages() { local fn=install_missingPackages;
    [ $DBG ] && echo "DBG: install_missingPackages()" 1>&2
    case "$DISTRO" in
    "brew")
      tmp="$( $0 -m 2>&1)"; [ -n "$tmp" ] && echo " + Missing:$(echo; echo "$tmp"|sed -e 's/^/     /')";
      ;;
    *)
      tmp="$( $0 -m|xargs echo )"; [ -n "$tmp" ] && echo " + Missing packages: '$tmp'";
      ;;
    esac

    [ $DBG ] && echo "DBG: missing packages: '$tmp'" 1>&2
    [ -z "$tmp" ] && return; # nothing to do

    case $DISTRO in
        fedora) yum install $tmp; ;; # yum install $( $0 -l )|grep -v 'already installed and latest version'; ;;
        brew)
            local taps="$(echo "$tmp"|sed -n 's/^.* [tT][aA][pP] \(.*\) needs to be tapped.*$/\1/p')";
            local formulae="$(echo "$tmp"|sed -n -e 's/^.* [bB][rR][eE][wW] \(.*\) needs to be installed.*$/\1/p' -e 's/^.* Formula \(.*\) needs to be installed.*$/\1/p')";
            local casks="$(echo "$tmp"|sed -n 's/^.* [cC][aA][sS][kK] \(.*\) needs to be installed.*$/\1/p')";
            [ $DBG ] && echo "DBG: [yes, install/update] --> taps: echo '$taps'|xargs -n 1 \"$c_brew\" tap" 1>&2;
            [ $DBG ] && echo "DBG: [yes, install/update] --> formulae: echo '$formulae'|xargs -n 10 \"$c_brew\" install" 1>&2;
            [ $DBG ] && echo "DBG: [yes, install/update] --> casks: echo '$casks'|xargs -n 10 \"$c_brew\" install --cask" 1>&2;
            getOK "\n   Do you want to install/update all the missing stuff? " || return 0;
            echo "..."
            [ -n "$taps" ]     && echo " > NEW TAPS:";         for a in $(echo "$taps"|xargs echo); do echo " >>   tap '$a'"; "$c_brew" tap "$a" || err 018 "FAILED [$?] \"$c_brew\" tap \"$a\"${NL}${NL}WITHIN LOOP TO INSTALL ALL TAPS: for a in $(echo $taps|xargs echo); do \"$c_brew\" tap \"\$a\""; done;
            [ -n "$formulae" ] && echo " > NEW FORMULAE:";     for a in $(echo "$formulae"|xargs echo); do echo " >>   '$a'"; "$c_brew" install "$a" || err 019 "FAILED [$?] \"$c_brew\" install \"$a\"${NL}${NL}WITHIN LOOP TO INSTALL ALL FORMULAE: for a in $(echo $formulae|xargs echo); do \"$c_brew\" install \"\$a\""; done
            [ -n "$casks" ]    && echo " > NEW CASKS:";        for a in $(echo "$casks"|xargs echo); do echo " >>   cask '$a'"; "$c_brew" install --cask "$a" || err 020 "FAILED [$?] \"$c_brew install --cask \"$a\"${NL}${NL}WITHIN LOOP TO INSTALL ALL casks: for a in $(echo $casks|xargs echo); do \"$c_brew\" install --cask \"\$a\"; done${NL}${NL}REMARK: In case of FAILING cask installs because the dir /Application already exists, you can use this to remove them (probably) all:${NL}"'echo "$casks"|while read a; do a2="$(echo "$a"|sed -e "s/[-]//g")"; a3="$(echo "$a"|tr "-" " ")"; for c in "$a" "$a2" "$a3"; do b="$(ls -1 /Applications|grep -i "$c")"; [ $DBG ] && echo "DBG: c=\"$c\" -> b=\"$b\""; [ -n "$b" ] && echo "$b"; done; done|sort|uniq|while read a; do echo "$a..."; rm "/Applications/$a"; done'; done
            #brew bundle --file="$KEEPFILE" install|grep -v "^Using ";
            ;;
        arch)  [ $DBG ] && echo "$c_ARCH -S $tmp" 1>&2
               $c_ARCH -S $tmp; ;; # $c_ARCH -Sy; $c_ARCH -S --needed --asexplicit $(cat "$KEEPFILE"|xargs echo); ;; 
        debian) apt-get install -V $tmp; ;; #  --no-install-recommends
        opensuse) zypper --verbose install --details $tmp; ;; #  --no-install-recommends
        *) XXXX $DISTRO $fn; ;;
    esac
}



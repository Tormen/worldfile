##########################################################################################################
# Self-tests: 'worldfile --run-tests [SUBSTRING]'. They run a COPY of this file whose settings point
# into a temp dir and whose package managers are stubs, so nothing is installed, removed or written
# outside that dir.

_rt_self() { # the real path of this file: follow symlinks one by one (no readlink -f on every BSD)
  _rt_p=$0
  while [ -L "$_rt_p" ]; do
    _rt_l=$(readlink "$_rt_p") || return 1
    case "$_rt_l" in
      /*) _rt_p=$_rt_l ;;
      *)  case "$_rt_p" in */*) _rt_p=${_rt_p%/*}/$_rt_l ;; *) _rt_p=$_rt_l ;; esac ;;
    esac
  done
  case "$_rt_p" in */*) _rt_d=${_rt_p%/*} ;; *) _rt_d=. ;; esac
  _rt_d=$(cd "${_rt_d:-/}" && pwd -P) || return 1
  echo "$_rt_d/${_rt_p##*/}"
}


_cleanup_() {
    [ $CLEANUP_DONE ] && return;
    [ $DBG ] && echo && echo "CLEANUP! ($?) [$*]" 1>&2;
    [ -n "$TEMPFILES" ] && rm -f $TEMPFILES;
    CLEANUP_DONE=1
    exit;
}



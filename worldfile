rebuild_keepfile_to_stdout() { local fn=rebuild_keepfile_to_stdout;
  # we DO allow space separated list of multiple packes in one line! -->  -e"s/ /\n/g" to split them :)
  case "$DISTRO" in
    brew)
      tmpFile=$(new_tempfile); TEMPFILES="$TEMPFILES $tmpFile";

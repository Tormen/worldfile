  brew)
    c_brew=$c_BREW
    [ -z "$c_brew" ] && for c_brew in /opt/homebrew/bin/brew /usr/local/bin/brew ""; do [ -x "$c_brew" ] && break; done
    [ -x "$c_brew" ] || err "no brew found (c_BREW='$c_BREW', /opt/homebrew/bin/brew, /usr/local/bin/brew)"
    ;;
esac

if [ $DBG ]; then
    echo "" 1>&2;
    echo "flag_rebuildKeepfile='$flag_rebuildKeepfile'" 1>&2
    echo "flag_nicifyPackagelist='$flag_nicifyPackagelist'" 1>&2
    echo "flag_PURGE='$flag_PURGE'" 1>&2;  # will be handled WITHIN each remove function!
    echo "DISTRO='$DISTRO'" 1>&2
    echo "WORLDFILE='$WORLDFILE'" 1>&2
    echo "KEEPFILE='$KEEPFILE'" 1>&2
    echo 1>&2;
    echo "cmd='$cmd'" 1>&2
    echo 1>&2;
fi;

###########################################################################################
### DO THINGS:

[ $flag_rebuildKeepfile ] && { rebuild_keepfile || err "Failed to rebuild keepfile (= temporary, stripped version of the worldfile)!"; }

if [ $flag_nicifyPackagelist ]; then
    #$cmd|nicifyPackagelist;
    $cmd >/tmp/a; cat /tmp/a|nicifyPackagelist;
else
    $cmd;
fi;


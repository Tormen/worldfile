        rpmorphan -zero-keep; rebuild_keepfile_to_stdout|while read a; do rpmorphan -use-cache -add-keep "$a"; done
    else
        _kd=${KEEPFILE%/*}; mkdir -p -- "$_kd" && rebuild_keepfile_to_stdout > "$KEEPFILE" # DEFAULT WAY TO CREATE KEEPFILE (by just stripping out everything but the pure packagenames from the worldfile)
    fi

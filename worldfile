err() { _err_c=$1; shift; echo "ERROR $_err_c [1]: $*" 1>&2; exit 1; } # err NNN "text" -- the code is unique per line: grep it, land on the line

XXXX() { err 001 "FUNCTION '$2' NOT YET IMPLEMENTED FOR DISTRO '$1'!!!"; }

config_search_paths() { # the config files looked for, in order, when neither $WORLDFILE_CONFIG nor --config names one
    printf '%s\n' "${LINKS:-/LINKS}/default/worldfile.conf" "${LINKS:-/LINKS}/default/worldfile" \
        "$HOME/.worldfile.conf" /etc/worldfile.conf /usr/local/etc/worldfile.conf
}

load_config() { # load_config [FILE] -- the defaults, then FILE ($WORLDFILE_CONFIG first) or the first one found
    eval "$(default_config_content)"
    _cf=${WORLDFILE_CONFIG:-$1}
    if [ -z "$_cf" ]; then
        for _p in $(config_search_paths); do [ -f "$_p" ] && { _cf=$_p; break; }; done
    fi
    if [ -n "$_cf" ]; then
        [ -r "$_cf" ] || err 002 "cannot read the config '$_cf'"
        # shellcheck disable=SC1090  # the config is chosen at run time
        . "$_cf" || err 003 "the config '$_cf' failed"
    fi
    [ -n "$DISTRO" ] || detect_distro
    [ -n "$WORLDFILE" ] || { os_token; WORLDFILE=/etc/package-list.$WF_OS; }
}

detect_distro() { # sets DISTRO to what this machine runs: brew on macOS, else the first known ID / ID_LIKE of os-release
    [ "$(uname -s)" = Darwin ] && { DISTRO=brew; return 0; }
    [ -r "$OS_RELEASE" ] || err 004 "cannot detect DISTRO: '$OS_RELEASE' is missing -- set DISTRO in the config (--create-config)"
    # shellcheck disable=SC1090,SC2153  # os-release is shell syntax and sets ID / ID_LIKE
    for _id in $(. "$OS_RELEASE"; echo "$ID $ID_LIKE"); do
        case "$_id" in
            fedora|arch|debian) DISTRO=$_id; return 0 ;;
            opensuse*)          DISTRO=opensuse; return 0 ;;
        esac
    done
    # shellcheck disable=SC1090  # os-release, as above
    err 005 "cannot detect DISTRO: no known ID in '$OS_RELEASE' ($(. "$OS_RELEASE"; echo "ID=$ID ID_LIKE=$ID_LIKE")) -- set DISTRO in the config"
}
OS_RELEASE=/etc/os-release

os_token() { # sets WF_OS to this machine's distribution, one token: macos on macOS, else os-release's ID as it stands
    [ "$(uname -s)" = Darwin ] && { WF_OS=macos; return 0; }
    [ -r "$OS_RELEASE" ] || err 006 "cannot name the distribution: '$OS_RELEASE' is missing -- set WORLDFILE in the config"
    # shellcheck disable=SC1090  # os-release, as above
    WF_OS=$(. "$OS_RELEASE"; echo "$ID")
    [ -n "$WF_OS" ] || err 007 "cannot name the distribution: no ID in '$OS_RELEASE' -- set WORLDFILE in the config"
}

# A world-file line may end its comment with a SELECTOR -- the machines it is for -- and then a
# set-up: 'brew "syncthing"  # file sync %DESKTOP+@myhost  setup: syncthing-setup --install'. A selector
# is %TIER or @host, then +TERM (add) or -TERM (remove), read left to right; no selector = every
# machine. A line whose selector does not name this machine is not in this machine's world file.
world_select() { # world_select MODE FILE -- FILE as this machine sees it (WF_TIER, WF_HOST):
                 #   lines   its lines for this machine, selector and set-up cut off;
                 #   setups  "ENTRY<tab>COMMAND" for each wanted entry of this machine, each COMMAND once;
                 #   tier    "tier" when a selector names a %TIER, nothing otherwise
    awk -v mode="$1" -v tier="$WF_TIER" -v host="$WF_HOST" -v tiers="$TIERS" '
    function fail(m) { printf "%s line %d: %s\n", FILENAME, FNR, m > "/dev/stderr"; exit 2 }
    function one(t,   n) {
        n = substr(t, 2)
        if (t !~ /^%/) return n == host
        if (tiers != "" && index(" " tiers " ", " " n " ") == 0) fail("\"" t "\" is no tier (TIERS: " tiers ")")
        if (tier == "") fail("\"" t "\" needs this machine'"'"'s tier, and TIER_COMMAND is empty (the config)")
        return n == tier
    }
    function selects(s,   i, c, op, from, r, v) { # an operator is always followed by % or @: a "-" in a host name is none
        op = ""; from = 1
        for (i = 2; i <= length(s) + 1; i++) {
            c = substr(s, i, 1)
            if (i <= length(s) && !(c ~ /[+-]/ && substr(s, i + 1, 1) ~ /[%@]/)) continue
            r = one(substr(s, from, i - from))
            v = (op == "") ? r : (op == "+") ? (v || r) : (v && !r)
            op = c; from = i + 1
        }
        return v
    }
    {
        line = $0; sel = ""; setup = ""; h = index(line, "#")
        if (h) {
            rest = substr(line, h); cut = length(rest) + 1
            if (match(rest, /[ \t#]setup:[ \t]/)) {
                setup = substr(rest, RSTART + RLENGTH); sub(/^[ \t]+/, "", setup); sub(/[ \t]+$/, "", setup)
                rest = substr(rest, 1, RSTART); cut = RSTART + 1
            }
            if (match(rest, /[ \t#][%@][^ \t%@+]+([+-][%@][^ \t%@+]+)*[ \t]*$/)) {
                sel = substr(rest, RSTART + 1); sub(/[ \t]+$/, "", sel); cut = RSTART + 1
            }
            if (sel != "" || setup != "") {
                line = substr(line, 1, h - 1) substr(rest, 1, cut - 1)
                sub(/[ \t]+$/, "", line)
                if (line ~ /(^|[ \t])#$/) { sub(/#$/, "", line); sub(/[ \t]+$/, "", line) }  # the comment held only those
            }
        }
        if (mode == "tier") { if (sel ~ /%/) { print "tier"; exit } next }
        if (sel != "" && !selects(sel)) next
        if (mode == "lines") { print line; next }
        if (setup == "" || (setup in seen)) next
        entry = line
        if (entry ~ /^[ \t]*#+[ \t]*manual[ \t]/) sub(/^[ \t]*#+[ \t]*/, "", entry)  # installed by hand: listed
        else if (entry ~ /^[ \t]*#/) next                                             # commented out: not wanted
        sub(/[ \t]*#.*/, "", entry); sub(/^[ \t]+/, "", entry); gsub(/[ \t]+/, " ", entry)
        seen[setup]; print entry "\t" setup
    }' "$2"
}

world_here() { # WORLDFILE becomes this machine's lines of it (a temp file); WORLDFILE_SRC keeps the file itself
    WORLDFILE_SRC=$WORLDFILE
    [ -r "$WORLDFILE_SRC" ] || return 0      # the command that reads it says so, as before
    WF_HOST="$(hostname -s)"; WF_TIER=
    if [ -n "$(world_select tier "$WORLDFILE_SRC")" ]; then
        [ -n "$TIER_COMMAND" ] || err 008 "'$WORLDFILE_SRC' names a %TIER, and TIER_COMMAND is empty: set it in the config to the command that prints this machine's tier"
        # shellcheck disable=SC2086  # TIER_COMMAND is a command line
        WF_TIER=$($TIER_COMMAND) || err 009 "FAILED [$?] TIER_COMMAND '$TIER_COMMAND'"
        [ -n "$WF_TIER" ] || err 010 "TIER_COMMAND '$TIER_COMMAND' printed no tier"
    fi
    WORLDFILE=$(new_tempfile); TEMPFILES="$TEMPFILES $WORLDFILE"
    world_select lines "$WORLDFILE_SRC" > "$WORLDFILE" || err 011 "cannot read the selectors of '$WORLDFILE_SRC' (above)"
}

create_config() { # create_config [FILE] -- the default config to stdout, or into FILE when it does not exist yet
    [ -z "$1" ] && { default_config_content; return; }
    [ -e "$1" ] && err 012 "--create-config: '$1' exists already -- not overwritten"
    default_config_content > "$1" || err 013 "--create-config: cannot write '$1'"
    echo " >>> default config written to $1"
}

new_tempfile() { # a new, empty temp file -- one per call
    mktemp "${TMPDIR:-/tmp}/worldfile.XXXXXX" || err 014 "mktemp failed"
}


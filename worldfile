        #debian) while read a; do [ -z "$a" ] && continue; echo "------ $a ------"; apt-cache search "^$a$"; return; done; ;;
    
        opensuse) while read a; do echo $a; done|xargs zypper --terse search --match-exact --case-sensitive --type package|tail -n+6; ;;

        *) XXXX $DISTRO $fn; ;;

